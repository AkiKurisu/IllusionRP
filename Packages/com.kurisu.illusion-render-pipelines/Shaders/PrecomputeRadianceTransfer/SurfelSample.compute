#pragma kernel CSMain

//--------------------------------------------------------------------------------------------------
// Included headers
//--------------------------------------------------------------------------------------------------

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PrecomputeRadianceTransfer/ProbeVolume.hlsl"

//--------------------------------------------------------------------------------------------------
// Inputs & outputs
//--------------------------------------------------------------------------------------------------

RWStructuredBuffer<Surfel> _surfels;
StructuredBuffer<float4> _sampleDirections;
TextureCube<float4> _worldPosCubemap, _normalCubemap, _albedoCubemap, _metadataCubemap;
SamplerState sampler_point_clamp;
float4 _probePos;
uint _sampleCount;
uint _surfelOutputOffset;

//--------------------------------------------------------------------------------------------------
// Implementation
//--------------------------------------------------------------------------------------------------

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _sampleCount) return;
    float3 direction = _sampleDirections[id.x].xyz;
    float4 normal = _normalCubemap.SampleLevel(sampler_point_clamp, direction, 0);
    Surfel result = (Surfel)0;
    if (normal.w == 0)
    {
        // sample sky
        result.flags = 1;
        result.position = _probePos.xyz + direction;
    }
    else
    {
        // opaque geometry
        float4 metadata = _metadataCubemap.SampleLevel(sampler_point_clamp, direction, 0);
        result.position = _worldPosCubemap.SampleLevel(sampler_point_clamp, direction, 0).xyz;
        result.normal = normalize(normal.xyz);
        result.albedo = _albedoCubemap.SampleLevel(sampler_point_clamp, direction, 0).rgb;
        result.renderingLayerMask = uint(metadata.x) | (uint(metadata.y) << 16);
        result.objectLayerMask = 1u << uint(metadata.w);
        result.materialKey = uint(metadata.z);
    }
    _surfels[_surfelOutputOffset + id.x] = result;
}
