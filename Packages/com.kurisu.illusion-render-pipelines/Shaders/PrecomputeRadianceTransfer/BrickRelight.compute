#pragma kernel CSMain

//--------------------------------------------------------------------------------------------------
// Included headers
//--------------------------------------------------------------------------------------------------

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PrecomputeRadianceTransfer/SolverProbeSampling.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PrecomputeRadianceTransfer/WorldLighting.hlsl"

//--------------------------------------------------------------------------------------------------
// Inputs & outputs
//--------------------------------------------------------------------------------------------------

StructuredBuffer<SurfelIndices> _brickInfo;
StructuredBuffer<Surfel> _surfels;
RWStructuredBuffer<float4> _brickRadiance;
uint _brickCount;

//--------------------------------------------------------------------------------------------------
// Implementation
//--------------------------------------------------------------------------------------------------

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint brick = id.x;
    if (brick >= _brickCount)
        return;
    SurfelIndices range = _brickInfo[brick];
    float3 radiance = 0;
    // Process all surfels in this brick
    for (uint offset = 0; offset < range.surfelCount; offset++)
    {
        uint index = range.surfelStart + offset;
        Surfel surfel = _surfels[index];
        float3 direct = EvaluatePRTWorldLighting(surfel, index);
        // radiance from the previous frame (treat as multi bounce indirect)
        float3 feedback = SamplePRTSolverProbe(surfel.nearestProbe, surfel.normal);
        radiance += surfel.albedo * (direct + feedback);
    }
    // Calculate averages
    _brickRadiance[brick] = float4(range.surfelCount > 0 ? radiance / float(range.surfelCount) : 0, 0);
}
