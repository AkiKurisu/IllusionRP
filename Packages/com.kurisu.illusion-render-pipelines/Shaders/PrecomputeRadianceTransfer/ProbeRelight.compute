#pragma kernel CSMain
#pragma kernel CSCommit
#pragma kernel CSPublish
#pragma kernel CSCopyDebug
#pragma kernel CSClearPublication

//--------------------------------------------------------------------------------------------------
// Included headers
//--------------------------------------------------------------------------------------------------

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/SphericalHarmonics.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PrecomputeRadianceTransfer/ProbeVolume.hlsl"

//--------------------------------------------------------------------------------------------------
// Inputs & outputs
//--------------------------------------------------------------------------------------------------

StructuredBuffer<PRTProbeData> _prtProbeData;
StructuredBuffer<BrickFactor> _factors;
StructuredBuffer<PRTSkySample> _prtSkySamples;
StructuredBuffer<float4> _brickRadiance;
StructuredBuffer<float4> _prtPreviousSH;
StructuredBuffer<uint> _validityMasks;
RWStructuredBuffer<float4> _prtNextSH;
StructuredBuffer<uint> _prtProbeIds;
StructuredBuffer<uint> _prtReady;
RWStructuredBuffer<float4> _prtResiduals;
RWStructuredBuffer<float4> _prtCommittedSH;
RWStructuredBuffer<uint> _prtCommittedMetadata;
RWStructuredBuffer<uint> _prtCommittedReady;
TextureCube<float4> _prtEnvironment;
SamplerState sampler_prtEnvironment;
float _prtEnvironmentIntensity;
uint _prtProbeCount;
float _prtAbsoluteTolerance;
float _prtRelativeTolerance;

#define PRT_THREADS 128
groupshared float3 shReduction[9][PRT_THREADS];

//--------------------------------------------------------------------------------------------------
// Implementation
//--------------------------------------------------------------------------------------------------

[numthreads(PRT_THREADS, 1, 1)]
void CSMain(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint localIndex = group.x;
    uint index = _prtProbeIds[localIndex];
    PRTProbeData probe = _prtProbeData[localIndex];
    float3 coefficients[9];
    for (uint initializeCoefficient = 0; initializeCoefficient < 9u; initializeCoefficient++)
        coefficients[initializeCoefficient] = 0;
    float intensity, validity;
    UnpackIntensityValidity(_validityMasks[index], intensity, validity);
    if (validity > 0)
    {
        for (uint edge = lane; edge < uint(probe.factorCount); edge += PRT_THREADS)
        {
            // Get factor and corresponding brick
            BrickFactor factor = _factors[probe.factorStart + edge];
            float3 radiance = _brickRadiance[factor.brickIndex].rgb;
            for (uint factorCoefficient = 0; factorCoefficient < 9u; factorCoefficient++)
                coefficients[factorCoefficient] += radiance * factor.sh[factorCoefficient];
        }
        for (uint sample = lane; sample < uint(probe.skyCount); sample += PRT_THREADS)
        {
            PRTSkySample sky = _prtSkySamples[probe.skyStart + sample];
            float3 radiance = _prtEnvironment.SampleLevel(sampler_prtEnvironment, sky.direction, 0).rgb
                * _prtEnvironmentIntensity;
            float basis[9];
            EvaluateSH9(sky.direction.xzy, basis);
            for (uint skyCoefficient = 0; skyCoefficient < 9u; skyCoefficient++)
                coefficients[skyCoefficient] += radiance * (sky.weight * basis[skyCoefficient]);
        }
    }
    // Process each SH coefficient and store to LDS
    for (uint storedCoefficient = 0; storedCoefficient < 9u; storedCoefficient++)
        shReduction[storedCoefficient][lane] = coefficients[storedCoefficient];
    GroupMemoryBarrierWithGroupSync();
    // Parallel reduction
    for (uint offset = PRT_THREADS / 2; offset > 0u; offset >>= 1)
    {
        if (lane < offset)
            for (uint reducedCoefficient = 0; reducedCoefficient < 9u; reducedCoefficient++)
                shReduction[reducedCoefficient][lane] += shReduction[reducedCoefficient][lane + offset];
        GroupMemoryBarrierWithGroupSync();
    }
    // Write results
    if (lane == 0u)
    {
        float ratio = 0;
        float difference = 0;
        float nonFinite = 0;
        for (uint outputCoefficient = 0; outputCoefficient < 9u; outputCoefficient++)
        {
            float3 value = shReduction[outputCoefficient][0];
            float3 previous = _prtPreviousSH[index * 9u + outputCoefficient].rgb;
            if (!all(isfinite(value)) || !all(isfinite(previous)))
                nonFinite += 1;
            float3 error = abs(value - previous);
            float3 threshold = _prtAbsoluteTolerance + _prtRelativeTolerance * max(abs(value), abs(previous));
            float3 scaled = error / threshold;
            ratio = max(ratio, max(scaled.x, max(scaled.y, scaled.z)));
            difference = max(difference, max(error.x, max(error.y, error.z)));
            _prtNextSH[localIndex * 9u + outputCoefficient] = float4(value, 0);
        }
        _prtResiduals[localIndex] = float4(ratio, difference, 0, nonFinite);
    }
}

[numthreads(64, 1, 1)]
void CSCommit(uint3 id : SV_DispatchThreadID)
{
    uint localIndex = id.x;
    if (localIndex >= _prtProbeCount) return;
    if (_prtResiduals[localIndex].w != 0) return;
    uint index = _prtProbeIds[localIndex];
    for (uint coefficient = 0; coefficient < 9u; coefficient++)
        _prtCommittedSH[index * 9u + coefficient] = _prtNextSH[localIndex * 9u + coefficient];
    _prtCommittedMetadata[index] = _validityMasks[index];
    _prtCommittedReady[index] = 1u;
}

int3 _prtPublishOffset;
int3 _prtPublishCount;
RWTexture3D<float4> _coefficientVoxel3D;
RWTexture3D<uint> _validityVoxel3D;
[numthreads(1, 1, 1)]
void CSClearPublication()
{
    for (uint clearCoefficient = 0; clearCoefficient < 9u; clearCoefficient++)
        _coefficientVoxel3D[int3(0, 0, clearCoefficient)] = 0;
    _validityVoxel3D[int3(0, 0, 0)] = 0u;
}
[numthreads(8, 4, 8)]
void CSPublish(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_prtPublishCount)))
        return;
    int3 slot = _prtPublishOffset + int3(id);
    int3 coordinate = _prtWindowMin.xyz + slot;
    uint index = PRTProbeIndex(coordinate);
    float intensity, validity;
    uint metadata = _prtReady[index] != 0u ? _validityMasks[index] : 0u;
    UnpackIntensityValidity(metadata, intensity, validity);
    for (uint publishedCoefficient = 0; publishedCoefficient < 9u; publishedCoefficient++)
        _coefficientVoxel3D[PRTTextureCoordinate(slot, publishedCoefficient)] =
            float4(_prtPreviousSH[index * 9u + publishedCoefficient].rgb * (intensity * validity), validity);
    int3 metadataCoordinate = int3(slot.x, slot.z, slot.y);
    _validityVoxel3D[metadataCoordinate] = metadata;
}

RWStructuredBuffer<float> _coefficientSH9;
uint _prtDebugProbeIndex;
[numthreads(32, 1, 1)]
void CSCopyDebug(uint3 dispatch : SV_DispatchThreadID)
{
    uint id = dispatch.x;
    if (id >= 27u)
        return;
    _coefficientSH9[id] = _prtPreviousSH[_prtDebugProbeIndex * 9u + id / 3u][id % 3u];
}
