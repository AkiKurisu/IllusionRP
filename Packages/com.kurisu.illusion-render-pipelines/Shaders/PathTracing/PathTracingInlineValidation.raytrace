#pragma max_recursion_depth 1
#pragma only_renderers d3d11

#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/Common.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PathTracing/PathTracingPayload.hlsl"
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/PathTracing/Inline/PathTracingInlineValidationCommon.hlsl"

RaytracingAccelerationStructure SceneBVH;
RWStructuredBuffer<uint4> _PathTracingInlineValidationSamples;

[shader("raygeneration")]
void PathTracingInlineValidationRayGen()
{
    uint2 pixel = DispatchRaysIndex().xy;
    IllusionPathPayload payload = PathTracingInlineValidationPayload(pixel);
    TraceRay(SceneBVH, RAY_FLAG_NONE, PT_INSTANCE_SCENE, 0, 1, 0, PathTracingInlineValidationRay(pixel), payload);
    PathTracingInlineValidationStore(_PathTracingInlineValidationSamples, pixel, payload);
}

[shader("miss")]
void PathTracingInlineValidationMiss(inout IllusionPathPayload payload : SV_RayPayload)
{
    payload.hitT = PT_MISS_T;
}
