#pragma max_recursion_depth 1
#pragma only_renderers d3d11
#pragma multi_compile_local _ ILLUSION_PT_SER
#pragma require Native16Bit int64BufferAtomics

#define PATH_TRACER_MODE PATH_TRACER_MODE_REFERENCE
#define RTXPT_PIPELINE_PERMUTATION_NAME GI
// Quality mode: the receiver is vertex 1; a path that the radiance cache does not end reaches up to eight more vertices.
#define PT_BOUNCE_COUNT 9
#define PT_DIFFUSE_BOUNCE_COUNT 9
// As HDRP's ray traced GBuffer does, Skin, Hair and Fabric secondary surfaces are shaded as standard Lit; Lit keeps its own
// model, as HDRP's ray traced quality mode does.
#define PT_STANDARD_LIT
#define RAY_TRACED_GI_RADIANCE_CACHE

#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/RayTracedGlobalIllumination/RayTracedGIInitialSamples.hlsl"
