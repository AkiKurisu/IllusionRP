#pragma only_renderers d3d11
#pragma kernel Composite
#pragma kernel StoreHistory
#pragma kernel PrepareGuides
#pragma kernel CompositeSpecular
#pragma kernel MergeReflection

#define NRD_HEADER_ONLY
#include "Packages/com.kurisu.illusion-render-pipelines/ShaderLibrary/NRD/NRD.hlsli"

#define DENOISER_MODE_OFF       0
#define DENOISER_MODE_REBLUR    1
#define DENOISER_MODE_RELAX     2

// Publishes the scene-linear diffuse signal pre-exposed, optionally averaged over a static view for validation.

Texture2D<float4> _RayTracedGIDiffuse;
uint _RayTracedGIDenoiserMode;
RWTexture2D<float4> _RayTracedGIAccumulation;
RWTexture2D<float4> _RayTracedGIOutput;
Texture2D<float2> _ExposureTexture;
uint2 _RayTracedGISize;
float _RayTracedGIAccumulationWeight;

float3 UnpackSignal(float4 signal)
{
    if (_RayTracedGIDenoiserMode == DENOISER_MODE_RELAX)
        return RELAX_BackEnd_UnpackRadiance(signal).rgb;
    if (_RayTracedGIDenoiserMode == DENOISER_MODE_REBLUR)
        return REBLUR_BackEnd_UnpackRadianceAndNormHitDist(signal).rgb;
    return signal.rgb;
}

[numthreads(8, 8, 1)]
void Composite(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _RayTracedGISize))
        return;

    float3 diffuse = UnpackSignal(_RayTracedGIDiffuse[id.xy]);
    if (_RayTracedGIAccumulationWeight > 0.0)
    {
        diffuse = lerp(_RayTracedGIAccumulation[id.xy].rgb, diffuse, _RayTracedGIAccumulationWeight);
        _RayTracedGIAccumulation[id.xy] = float4(diffuse, 1.0);
    }
    _RayTracedGIOutput[id.xy] = float4(diffuse * _ExposureTexture.Load(int3(0, 0, 0)).x, 1.0);
}

Texture2D<float4> _RayTracedGISpecular;
RWTexture2D<float4> _RayTracedGISpecularAccumulation;
RWTexture2D<float4> _RayTracedGISpecularOutput;

[numthreads(8, 8, 1)]
void CompositeSpecular(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _RayTracedGISize))
        return;

    float3 specular = UnpackSignal(_RayTracedGISpecular[id.xy]);
    if (_RayTracedGIAccumulationWeight > 0.0)
    {
        specular = lerp(_RayTracedGISpecularAccumulation[id.xy].rgb, specular, _RayTracedGIAccumulationWeight);
        _RayTracedGISpecularAccumulation[id.xy] = float4(specular, 1.0);
    }
    _RayTracedGISpecularOutput[id.xy] = float4(specular * _ExposureTexture.Load(int3(0, 0, 0)).x, 1.0);
}

Texture2D<float> _RayTracedGIDepth;
Texture2D<float4> _RayTracedGINormals;
Texture2D<float4> _RayTracedGIForwardGBuffer;
RWTexture2D<float> _RayTracedGIPrevDepth;
RWTexture2D<float4> _RayTracedGIPrevNormalRoughness;
// The linear view depth of a camera texel is dot(_RayTracedGIViewDepthZ, p) / dot(_RayTracedGIViewDepthW, p), with
// p = (texel + 0.5, device depth, 1), through the projection the camera depth was rendered with.
float4 _RayTracedGIViewDepthZ;
float4 _RayTracedGIViewDepthW;
float _RayTracedGIFarDepth;
uint _RayTracedGITextureScale;
uint2 _RayTracedGITextureSize;

uint2 TextureTexel(uint2 pixel)
{
    return min(pixel * _RayTracedGITextureScale, _RayTracedGITextureSize - 1);
}

float ViewDepth(uint2 texel, float deviceDepth)
{
    float4 position = float4(float2(texel) + 0.5, deviceDepth, 1.0);
    return dot(_RayTracedGIViewDepthZ, position) / dot(_RayTracedGIViewDepthW, position);
}

// Keeps this frame's receivers for the next frame's temporal resampling; the far depth marks pixels without a receiver.
[numthreads(8, 8, 1)]
void StoreHistory(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _RayTracedGISize))
        return;

    uint2 texel = TextureTexel(id.xy);
    float deviceDepth = _RayTracedGIDepth.Load(int3(texel, 0));
    float3 normal = _RayTracedGINormals.Load(int3(texel, 0)).xyz;
    bool valid = deviceDepth != _RayTracedGIFarDepth && dot(normal, normal) > 1e-6;
    _RayTracedGIPrevDepth[id.xy] = valid ? deviceDepth : _RayTracedGIFarDepth;
    _RayTracedGIPrevNormalRoughness[id.xy] = float4(valid ? normalize(normal) : 0.0, 1.0 - _RayTracedGIForwardGBuffer.Load(int3(texel, 0)).r);
}

#define STENCIL_USAGE_IS_SSR (1 << 2)

Texture2D<float4> _RayTracedGIScreenSpaceReflection;
Texture2D<float4> _RayTracedGISpecularLighting;
Texture2D<uint2> _RayTracedGIStencil;
Texture2D<float> _RayTracedGIPostDepth;
uint _RayTracedGIComparePostDepth;
RWTexture2D<float4> _RayTracedGIReflection;

// SSR hits keep their weight; RTGI specular covers the rest of each opaque receiver that SSR traces, so reflection probes
// only fill pixels that neither reaches. A transparent surface written into the post-depth keeps SSR's result alone.
[numthreads(8, 8, 1)]
void MergeReflection(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _RayTracedGISize))
        return;

    float4 reflection = _RayTracedGIScreenSpaceReflection.Load(int3(id.xy, 0));
    float deviceDepth = _RayTracedGIDepth.Load(int3(id.xy, 0));
    float3 normal = _RayTracedGINormals.Load(int3(id.xy, 0)).xyz;
    bool receiver = deviceDepth != _RayTracedGIFarDepth && dot(normal, normal) > 1e-6
        && (_RayTracedGIStencil.Load(int3(id.xy, 0)).y & STENCIL_USAGE_IS_SSR) != 0
        && (_RayTracedGIComparePostDepth == 0 || _RayTracedGIPostDepth.Load(int3(id.xy, 0)) == deviceDepth);
    float coverage = receiver ? 1.0 - reflection.a : 0.0;
    _RayTracedGIReflection[id.xy] = float4(reflection.rgb + coverage * _RayTracedGISpecularLighting.Load(int3(id.xy, 0)).rgb,
        reflection.a + coverage);
}

RWTexture2D<float> _RayTracedGIViewZ;
RWTexture2D<float4> _RayTracedGINormalRoughness;
Texture2D<float2> _RayTracedGIMotion;
RWTexture2D<float4> _RayTracedGIMotionVectors;
float _RayTracedGIDenoisingRange;

// The NRD guides: view-space Z of the camera matrices (negative in front of a Unity camera), packed normal and roughness,
// and the URP motion vectors, or zero motion when NRD derives the camera motion from the matrices.
[numthreads(8, 8, 1)]
void PrepareGuides(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _RayTracedGISize))
        return;

    uint2 texel = TextureTexel(id.xy);
    float deviceDepth = _RayTracedGIDepth.Load(int3(texel, 0));
    float3 normal = _RayTracedGINormals.Load(int3(texel, 0)).xyz;
    bool valid = deviceDepth != _RayTracedGIFarDepth && dot(normal, normal) > 1e-6;
    float roughness = 1.0 - _RayTracedGIForwardGBuffer.Load(int3(texel, 0)).r;
    _RayTracedGIViewZ[id.xy] = valid ? -ViewDepth(texel, deviceDepth) : -2.0 * _RayTracedGIDenoisingRange;
    _RayTracedGINormalRoughness[id.xy] = NRD_FrontEnd_PackNormalAndRoughness(valid ? normalize(normal) : float3(0.0, 0.0, 1.0), roughness, 0.0);
    _RayTracedGIMotionVectors[id.xy] = float4(_RayTracedGIMotion.Load(int3(texel, 0)), 0.0, 0.0);
}
